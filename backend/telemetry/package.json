{
  "name": "@cm/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "inspect": "node --import=tsx/esm src/inspect.ts",
    "build": "wrangler deploy --dry-run --outdir=dist --env dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@cm/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260621.1",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.9",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "4.103.0"
  }
}
