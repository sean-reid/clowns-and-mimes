{
  "name": "clowns-and-mimes",
  "version": "0.0.0",
  "private": true,
  "description": "Clowns and Mimes, on Miscellaneous Topological Spaces... IN THE DARK",
  "license": "MIT",
  "author": "Sean Reid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean-reid/clowns-and-mimes.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "gen:movement-fixture": "tsx scripts/gen-movement-fixture.ts",
    "gen:gridmaze-fixture": "tsx scripts/gen-gridmaze-fixture.ts",
    "gen:topology-fixture": "tsx scripts/gen-topology-fixture.ts",
    "gen:physics-fixture": "tsx scripts/gen-physics-fixture.ts",
    "gen:mobius-fixture": "tsx scripts/gen-mobius-fixture.ts",
    "gen:items-fixture": "tsx scripts/gen-items-fixture.ts",
    "gen:bot-pathfinder-fixture": "tsx scripts/gen-bot-pathfinder-fixture.ts",
    "gen:bot-decision-fixture": "tsx scripts/gen-bot-decision-fixture.ts"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "typescript": "5.6.3"
  }
}
